# MySQL для демо: только для сайта в этом же контейнере, данные учебные и живут до перезапуска.
# Настроен под 512 МБ на весь контейнер: всё, что не нужно блогу, выключено, буферы маленькие
[mysqld]
user = mysql
datadir = /var/lib/mysql
socket = /run/mysqld/mysqld.sock
pid-file = /run/mysqld/mysqld.pid
# Сайт и сидер подключаются через сокет: TCP, а с ним и обмен RSA-ключом для пароля по незащищённому каналу не нужны
skip-networking
mysqlx = OFF
disable-log-bin
# Чтение и запись файлов сервером (LOAD DATA, INTO OUTFILE) блогу не нужны
secure-file-priv = NULL

# Журнал ошибок не задан, значит идёт в stderr - в лог контейнера; с заметками о каждом шаге запуска
log_error_verbosity = 3

# Песочница хостинга может не пускать Linux native AIO: mysqld тогда молча погибает на первом io_setup() -
# так выглядело падение демо на Render.
# Без него InnoDB ведёт ввод-вывод своими потоками, а без O_DIRECT - через обычный кэш и fsync; блогу этого хватает
innodb_use_native_aio = OFF
innodb_flush_method = fsync

performance_schema = OFF
# Без прав на NUMA в контейнере MySQL при включённой настройке только пишет предупреждения
innodb_numa_interleave = OFF
innodb_buffer_pool_size = 32M
innodb_log_buffer_size = 4M
innodb_redo_log_capacity = 16M
# Данные всё равно пересоздаются при каждом старте: сбрасывать журнал на диск после каждой транзакции незачем
innodb_flush_log_at_trx_commit = 2
key_buffer_size = 1M
max_connections = 20
table_open_cache = 200
tmp_table_size = 8M
max_heap_table_size = 8M
