{
    "name": "gegirhasut/php-smarty-blog",
    "description": "Блог с категориями и статьями на чистом PHP, Smarty и MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "smarty/smarty": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse"
    }
}
